   115                        
   116                        		; SEP		#$30		; 8 bit register A/X/Y
   117                        		; LONGI	OFF			; and tell assembler about it 
   118                        		; LONGA	OFF
   119                        
   120                        		; init circular input buffer 
   121                        		; STZ		RD_IDX		; read pointer to SoB 
   122                        		; STZ		WR_IDX		; write pointer to SoB 
   123                        
   124 00:0004: C2 30                REP   	#$30		; C2 30: 16 bit registers A/X/Y 
   125                                LONGI 	ON			; and tell assembler about it 
   126                                LONGA 	ON
