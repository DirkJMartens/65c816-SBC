    32                        .TWOCHAR	ON				; enable use of CR, LF, NL, HT, SP mnemonics 
    33                        
    34             00007DFF   STACK   	EQU   	$7DFF   ; Top of Stack, near top of RAM. Grows towards smaller addresses. 
    35             00007000   SP_FGND		EQU		$7000	; SP location to save main SP ToS (3 bytes)
    36             00007002   SP_ISR		EQU		$7002	; SP location to save ISR SP ToS (3 bytes)
    37                        
    38             00007F80   ACIA_DATA	EQU		$7F80	; ACIA DATA REGISTER (Tx and Rx data register) 
    39             00007F81   ACIA_STAT	EQU		$7F81	; ACIA STATUS REGISTER (Err bits, TxDR, RxDR, DCDB, DSRB, IRQ) 
    40             00007F82   ACIA_CMD	EQU		$7F82	; ACIA COMMAND REGISTER (DTR, RIE, TxC, Echo, Parity) 
    41             00007F83   ACIA_CTRL	EQU		$7F83	; ACIA CONTROL REGISTER (Baudrate, Data length, Stop bits) 
    42                        
    43             00007FE0   PORTB		EQU		$7FE0	; I/O port B on VIA2
    44             00007FE1   PORTA		EQU		$7FE1	; I/O port A on VIA2
    45             00007FE2   DDRB		EQU		$7FE2	; data direction register B on VIA2 (1=out; 0=in)
    46             00007FE3   DDRA		EQU		$7FE3	; data direction register A on VIA2 (1=out; 0=in)
    47                         
    48             00000026   STL         EQU 	$26		;mem addr low 
    49             00000027   STH         EQU 	$27		;mem addr high 
    50             00000028   L           EQU		$28		;ASCII to HEX value low 
    51             00000029   H           EQU 	$29		;ASCII to HEX value high 
