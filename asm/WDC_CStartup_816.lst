   128 00:0006: A9 FF 7D             LDA   	#STACK      ; A9 FF 7D: get the stack address 
   129 00:0009: 1B                   TCS                	; 1B: and set the stack pointer to it 
   130                        ; *******E
   131                        
   132                        ; *******S		; setup the databank register
   133 00:000A: E2 20        		SEP #$20			; E2 20: A register 8 bit 
   134                        		LONGA OFF			; tell assembler 
   135 00:000C: A9 xx        		LDA #^_BEG_DATA		; A9 00: get bank part of DATA section 
   136 00:000E: 48           		PHA					; 48: push it onto stack  
   137 00:000F: AB           		PLB					; AB: and pull it into data bank register 
   138 00:0010: C2 20        		REP #$20			; C2 20: A register 16 bit 
   139                        		LONGA ON 
   140                        
   141                        ; The assembler creates 3 symbols for each (user-defined) section: 
   142                        ; 		_ROM_BEG_secname 	: this is the ROM location of the section 
   143                        ; 		_BEG_secname 		: this is the execution beginning of the section 
   144                        ; 		_END_secname		: this is the end of the section 
   145                        ;			E.g. _ROM_BEG_STARTUP, _BEG_STARTUP and _END_STARTUP 
   146                        ; 5 sections are always automatically created: 
   147                        ; 		PAGE0 : for 6502: $0000 to $00FF; for 65816: $0000 to $FFFF (must be RAM)
   148                        ; 		CODE : main program section (typ. in ROM) 
   149                        ;		KDATA : constant data that never changes (e.g. constant strings; typ. in ROM)
   150                        ; 		DATA : initialized data that will be modified (e.g. int cnt=0; cnt++, typ. RAM) 
   151                        ;		UDATA : data that is not initialized (e.g. int temp; must be in RAM)
   152                        ; The user can define up to 250 additional ones using "name: SECTION" 
   153                        
   154                        ; These symbols can be used by the programmer in the code to access, read, copy ... 
   155                        
   156                        ; Copy (initialized) DATA from ROM to RAM 
   157                        ; 		assumes that DATA has been linked to reside in RAM but is
   158                        ; 		physically in ROM starting at location _ROM_BEG_DATA 
   159                        ; 		comment out this section if DATA does not need to be copied from ROM to RAM 
   160                        
   161 00:0012: A9 xx xx             LDA   #_END_DATA-_BEG_DATA 			; A9 B2 01: number of bytes to copy
   162                        					; BEG_DATA ~ 0x2000 and END_DATA ~ 0x21B2 
   163 00:0015: F0 0A                BEQ   SKIP         					; F0 0A: if none, skip rest and jump
                     to SKIP
   164 00:0017: 3A                   DEC   A            					; 3A: less one for MVN instruction
   165 00:0018: A2 xx xx             LDX   #<_ROM_BEG_DATA 				; A2 00 20: low 16 bits of source (ROM) addr
  Mon Nov  2 2026  0:10                                                                                                    Page 4


                     into X
   166 00:001B: A0 xx xx             LDY   #<_BEG_DATA  					; A0 00 20: low 16 bits of dest (RAM
                    ) addr into Y
   167 00:001E: 54 xx xx             MVN   #^_ROM_BEG_DATA,#^_BEG_DATA 	; 54 00 00: copy bytes using the bank parts of ROM/RAM 
   168                        ; *******E
   169                        
   170                        SKIP:
   171                        ; fill the uninitialized UDATA area with zeroes 
   172                        ; UDATA is uninitialized, so it does not need to be in ROM and also not copied to RAM 
   173                        ; *******S
   174 00:0021: A2 xx xx     		LDX   #_END_UDATA-_BEG_UDATA  		; A2 02 00: get number of bytes to clear
   175                        					; BEG_UDATA ~ 0x21B2 and END_UDATA ~ 0x21B4 
   176 00:0024: F0 11                BEQ   DONE         					; F0 11: if none, skip rest and jump
                     to DONE 
   177 00:0026: A9 00 00             LDA   #0           					; A9 00 00: load the zero to clear U
                    DATA section in A reg 
   178 00:0029: E2 20                SEP   #$20       					; E2 20: A register 8 bits, so do byte at a 
                    time
   179 00:002B: A0 xx xx             LDY   #_BEG_UDATA					; A0 B2 21: get beginning of UDATA into Y 
   180                        						
   181 00:002E: 99 00 00     LOOP    STA   |0,Y       					; 99 00 00: clear memory using the 0 from A 
                    register 
   182 00:0031: C8                   INY              					; C8: bump pointer
   183 00:0032: CA                   DEX              					; CA: decrement count
   184 00:0033: D0 F9                BNE   LOOP       					; D0 F9: loop till done
   185 00:0035: C2 20                REP   #$20       					; C2 20: 16 bit memory reg
   186                        DONE:
   187                        ; *******E
   188                        
   189                        ; transfer control to the main() function in the C program 
   190                        	IF SMALL
   191                        ; XREF = symbol declared outside this file (declare = name + type specified, no value assigned) 
   192                        ; XDEF = symbol defined in this file (i.e. value assigned) but referenced in another file 
   193                        		XREF __main     ; jumps to "main" function of C program  
   194                        						; XREF tells assembler that the linker will fill in the addr
                    ess 
   195                        						; declare it as "extern void START (void);" in the file with
                     main() 
   196                        						; and update reset vector accordingly 
   197 00:0037: 22 xx xx xx  		JSR >__main    	; 22 B3 97 00: using '>' to force long jump (in case not bank 0) (changes JS
                    R into JSL) 
   198 00:003B: 00 00        		BRK				; 00 00
   199                        	ENDIF
   200                        
   201                        ; declare special linker symbols for the linker to fill in 
   202                        ; XREF = symbol declared outside this file (declare = name + type specified, no value assigned) 
   203                        	XREF  _BEG_DATA
   204                        	XREF  _END_DATA
   205                        	XREF  _ROM_BEG_DATA
   206                        	
   207                        	XREF  _BEG_UDATA
   208                        	XREF  _END_UDATA
