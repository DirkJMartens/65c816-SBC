   292                        ;interrupt vector table
   293                        VECTORS: SECTION		
   294                        ; mapped at $FFE0 using "AVECTORS=FFE0" in .bat file 
   295                        ; *******S
   296                        	; the real reset and interrupt vectors
   297                        
   298                        ; replace Undefined_IRQ with actual interrupt routine name 
   299                        ; they can only be 16 bits wide, so the IRQ routine must be in bank 0
   300                        
   301                        ; If not in bank 0, replace Undefined_IRQ with label "JMP0" and 
   302                        ;	put in ORG directive 
   303                        ; 		ORG xxxxx 
   304                        ; before the label and long jump instruction 
   305                        ; 		JMP0 	JMP >FUNC0 
   306                        ; and then write the FUNC0 interrupt handler function 
   307                        ; where ">" indicates long (=16 bit) pointers 
   308                        
   309                        	; 65C816 Vectors
   310                        	; Status bit E = 0 (Native mode)
   311 00:0000:              	ds	4				; $FFE0,1 - Reserved 
   312                        						; $FFE2,3 - Reserved
   313 00:0004: xx xx        	dw	N_COP			; $FFE4,5 - Co-Processor 	(65816 mode)
   314 00:0006: xx xx        	dw	N_BRK			; $FFE6,7 - Brk 			(65816 mode)
   315 00:0008: xx xx        	dw	N_ABORT			; $FFE8,9 - Abort 			(65816 mode - pin 3)
   316 00:000A: xx xx        	dw	N_NMI			; $FFEA,B - NMI 			(65816 mode - pin 6)
   317 00:000C:              	ds	2				; $FFEC,D - Reserved 		(65816 mode)
   318 00:000E: xx xx        	dw	__IRQPinHandler	; $FFEE,F - IRQ 			(65816 mode - pin 4)
   319                        
   320                        	; 6502 Vectors
   321                        	; Status bit E = 1 (Emulation mode)
   322 00:0010:              	ds 	4				; $FFF0,1 - Reserved 		(6502 mode)
   323                        						; $FFF2,3 - Reserved 		(6502 mode)
   324 00:0014: xx xx        	dw	E_COP			; $FFF4,5 - Co-Processor 	(6502 mode)
   325 00:0016:              	ds	2				; $FFF6,7 - Reserved 		(6502 mode)
   326 00:0018: xx xx        	dw	E_ABORT			; $FFF8,9 - Abort 			(6502 mode - pin 3)
   327 00:001A: xx xx        	dw	E_NMI			; $FFFA,B - NMI 			(6502 mode - pin 6)
   328 00:001C: xx xx        	dw	E_RESET			; $FFFC,D - Reset 			(6502 mode - pin 40)
   329 00:001E: xx xx        	dw	__IRQPinHandler	; $FFFE,F - IRQ/BREAK 		(6502 mode - pin 4)
