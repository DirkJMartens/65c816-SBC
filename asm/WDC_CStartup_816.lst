    57                        ; ASM macros to e.g. switch between 8 and 16 bit registers 
    58                        ; mostly definitions for the WDC assembler 
    59                        ; *******S
    60                        R16 .MACRO			; A and X/Y both 16 bits 
    61                        	LONGA ON
    62                        	LONGI ON
    63                        	REP #$30
    64                        	.ENDM
    65                        R8 .MACRO			; A and X/Y both 8 bits 
    66                        	LONGA OFF
    67                        	LONGI OFF
    68                        	SEP #$30
    69                        	.ENDM
    70                        A16 .MACRO			; A now 16 bits 
    71                        	LONGA ON
    72                        	REP #$20
    73                        	.ENDM
    74                        A8 	.MACRO			; A now 8 bits 
    75                        	LONGA OFF
    76                        	SEP #$20
    77                        	.ENDM
    78                        I16 .MACRO			; X/Y now 16 bits 
    79                        	LONGI ON
    80                        	REP #$10
    81                        	.ENDM
    82                        I8 	.MACRO			; X/Y now 8 bits 
    83                        	LONGI OFF
    84                        	SEP #$10
    85                        	.ENDM
